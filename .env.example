ENCORE_DB=encore.db
ENCORE_PORT=8000

# LLM for card generation + the web agent: gemini (default) or bedrock; none = offline card generation (tests)
LLM_PROVIDER=gemini
# Gemini: free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Thinking level, sent by default only for gemini-3.1-flash-lite; empty disables
# GEMINI_THINKING_LEVEL=minimal

# Optional: Amazon Bedrock instead of Gemini (LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
